# --- Base de datos ---
# Local: mongodb://localhost:27017/agencia_viajes
# Producción (MongoDB Atlas): mongodb+srv://USUARIO:CONTRASEÑA@cluster.xxxxx.mongodb.net/agencia_viajes
MONGODB_URI=mongodb://localhost:27017/agencia_viajes
# Conexiones por instancia (en Vercel cada instancia de la función abre su propio pool).
MONGODB_POOL=10

# --- Seguridad ---
# Obligatoria en producción: cadena larga y aleatoria (p.ej. 64 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

CORS_ORIGENES=

# --- Servidor local (npm run server) ---
PORT=4000
